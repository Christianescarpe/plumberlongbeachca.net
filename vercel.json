{
  "buildCommand": "cd plumberlongbeachca-site-package/long-beach-plumbing-referral/source && node src/build.mjs",
  "outputDirectory": "plumberlongbeachca-site-package/long-beach-plumbing-referral/source/dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
